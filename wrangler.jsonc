{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workers-langchain-python",
  "main": "src/main.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "INFERENCE_LIMITER",
      "namespace_id": "2",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
